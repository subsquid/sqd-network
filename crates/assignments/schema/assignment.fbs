// When changing this file, regenerate the sources by running
// flatc --rust -o gen ./assignment.fbs ./worker_assignment.fbs ./portal_assignment.fbs
//
// worker_assignment.fbs and portal_assignment.fbs (NET-1180) each `include` this file to reuse
// WorkerStatus/WorkerId/EncryptedHeaders/WorkerEntry -- see those files for the split rationale.

table Assignment {
  datasets: [Dataset] (required);
  workers: [WorkerEntry] (required);
}

enum WorkerStatus: byte {
  Ok,
  Unreliable,
  DeprecatedVersion,
  UnsupportedVersion,
}

// A worker's entry within a published assignment: identity, serve-eligibility status, and the
// sealed HTTP auth headers for the storage backend. Renamed from `WorkerAssignment` (NET-1180) to
// free that name for the new worker-facing root table in worker_assignment.fbs, which reuses this
// same table; this type is internal to the assignments crate (builder.rs/reader.rs) and was never
// referenced by name elsewhere.
table WorkerEntry {
  worker_id: WorkerId (required);  // sorted by parsed PeerId

  chunks: [Chunk] (deprecated);

  status: WorkerStatus;
  encrypted_headers: EncryptedHeaders;
}

table Dataset {
  id: string (key);  // e.g. "s3://solana-mainnet-2"
  chunks: [Chunk] (required);
  last_block: uint64;
}

table Chunk {
  first_block: uint64 (key);
  id: string (required);  // e.g. "0221000000/0221000000-0221000649-9QgFD"
  dataset_id: string (required);  // e.g. "s3://solana-mainnet-2"
  size: uint32;
  last_block_hash: string;
  last_block_timestamp: uint64 = null;
  dataset_base_url: string (required);  // shared memory across all chunks of the dataset
  base_url: string (required);  // relative url added to dataset_base_url
  files: [FileUrl] (required);
  worker_indexes: [uint16] (required);
}

// A chunk's short hash at fixed width, which keeps a hash column a flat array. Writers emit 5 to 8
// characters and NUL pads the rest, since '0' is itself a valid hash character. Assembling a chunk
// id trims the trailing NULs. Shared by both split formats, which describe the same chunks.
struct ChunkHash {
  bytes: [ubyte:8];
}

// The top-level directory a run of chunks lives under: the `0221000000` of
// "0221000000/0221000000-0221000649-9QgFD". Writers close a top directory on a chunk count (1000
// in subsquid/data, 500 in squid-sdk, older datasets differ), so the top follows the chunk sequence
// and travels on the wire. It holds constant across a directory, so it travels as runs: ~N/1000
// entries, 80 KB against 40 MB on 5M chunks.
//
// A run covers chunks from its `first_chunk_index` until the next run's, so a lookup searches this
// column for the chunk index that subscripts the others. The first run starts at chunk 0 and the
// rest strictly ascend, which gives that search a run to land on; the builder enforces both.
struct TopRun {
  first_chunk_index: uint32;
  top: uint64;
}

table FileUrl {
  filename: string (required);
  url: string (required);  // may be a relative url added to dataset_base_url + base_url
}

struct WorkerId {
  peer_id: [ubyte:38];
}

table EncryptedHeaders {
  identity: [ubyte] (required);
  nonce: [ubyte] (required);
  ciphertext: [ubyte] (required);
}

root_type Assignment;
