// When changing this file, regenerate the sources by running
// flatc --rust -o gen ./assignment.fbs ./worker_assignment.fbs ./portal_assignment.fbs

include "assignment.fbs";

// --- NET-1180: worker-oriented assignment ---
//
// The legacy `Assignment` (assignment.fbs) is served identically to both workers and portals
// today. This root type diverges that content to carry only what a worker actually reads (see
// docs/assignment-wire-format.md in network-scheduler for the field-by-field trace). Published as
// NetworkState's `worker_assignment` blob.
//
// A chunk's `write_schema_id` names its write schema -- the one covering every table and column
// physically present in the chunk. The portal's `read_schema_id` is a client-facing view that may
// hide tables; the two are separate id spaces. Column-level schema content stays out of scope
// here (NET-1180) and lives in NetworkState's schema bundle.

table WorkerAssignment {
  datasets: [WorkerAssignmentDataset] (required);
  workers: [WorkerEntry] (required);
  schemas: [TableRoster] (required);  // sorted by id, as (key) lookup requires
}

// Ordering is fixed at publication and travels with the bitmap, so a schema that gains tables
// later cannot change what an already published blob means.
table TableRoster {
  write_schema_id: uint32 (key);
  tables: [string] (required);  // sorted; bit i of `tables_present` <-> tables[i]
}

table WorkerAssignmentDataset {
  id: string (key);  // e.g. "s3://solana-mainnet-2"
  chunks: [WorkerAssignmentChunk] (required);
  last_block: uint64;
}

table WorkerAssignmentChunk {
  first_block: uint64 (key);
  id: string (required);
  dataset_id: string (required);
  size: uint32;
  dataset_base_url: string (required);  // shared across all chunks of the dataset
  // No per-chunk base_url: the legacy field was always just `id` restated
  // (see sqd-assignments builder.rs), so the worker builds the download prefix from
  // dataset_base_url + id directly.
  write_schema_id: uint32;
  // Bitmap over `schemas[write_schema_id].tables`: bit i (byte i/8, LSB-first) set = tables[i]
  // present. Absent (null) = every table present.
  tables_present: [ubyte];
  worker_indexes: [uint16] (required);
}

root_type WorkerAssignment;
