// When changing this file, regenerate the sources by running
// flatc --rust -o gen ./assignment.fbs ./worker_assignment.fbs ./portal_assignment.fbs
//
// Each field's `id` fixes its slot, so a new field takes the next free id and sits wherever it
// reads best. Renumbering repoints every published blob, so ids stay put. Ids run consecutively
// from 0, so `(deprecated)` retires a field.

include "assignment.fbs";

// The worker-facing assignment: what a worker needs to download and serve its chunks. Published as
// NetworkState's `worker_assignment` blob; see docs/assignment-wire-format.md in network-scheduler
// for the field-by-field trace.
//
// A chunk's `write_schema_id` names its write schema -- the one covering every table and column
// physically present in the chunk. The portal's `read_schema_id` is a client-facing view that may
// hide tables; the two are separate id spaces. Column-level schema content lives in NetworkState's
// schema bundle.

table WorkerAssignment {
  datasets: [WorkerAssignmentDataset] (required, id: 0);
  workers: [WorkerEntry] (required, id: 1);
  schemas: [TableRoster] (required, id: 2);  // sorted by id, as (key) lookup requires
}

// Ordering is fixed at publication and travels with the bitmap, so a published blob keeps its
// meaning as the schema gains tables.
table TableRoster {
  write_schema_id: uint32 (key, id: 0);
  tables: [string] (required, id: 1);  // sorted; bit i of `tables_present` <-> tables[i]
}

table WorkerAssignmentDataset {
  id: string (key, id: 0);  // e.g. "s3://solana-mainnet-2"
  chunks: [WorkerAssignmentChunk] (required, id: 1);
  last_block: uint64 (id: 2);
  // Storage prefixes of the dataset's chunk versions, sorted by version as the (key) lookup
  // requires. A version-0 chunk is the ingested one, resolved straight from dataset_base_url, so
  // this covers versions 1 and up and appears with the first rewrite.
  generations: [GenerationEntry] (id: 3);
}

// A batch job writes its copy of a chunk under its own prefix and publishes it by bumping the
// chunk's `version`. Readers see a consistent chunk throughout the run, and a generation stays
// private until it is published.
//
// A chunk's files therefore live at
//   dataset_base_url + id                                   (version 0, straight from ingest)
//   dataset_base_url + generations[version].base_url + id   (any other version)
//
// which for a dataset laid out as
//
//   s3://ethereum-mainnet/
//   |-- 0000000000/                                  <- ingest
//   |-- 0001000000/
//   `-- _bf/
//       |-- 01HQZK3M7X8P2NVWTC4RYFGDS9/              <- one job's output
//       |   `-- 0000000000/
//       |       `-- 0000116400-0000127899-274f02d8/
//       `-- 01HR2A9B4C6D8E0F2G4H6J8K0M/
//
// means a `_bf/01HQZK3M7X8P2NVWTC4RYFGDS9` entry, whose version the rewritten chunks carry.
table GenerationEntry {
  version: uint32 (key, id: 0);
  base_url: string (required, id: 1);  // relative to dataset_base_url, e.g. "_bf/01HQZK..."
}

// A chunk is reached through the dataset holding it, which is where its dataset id stays: one per
// chunk costs 8 bytes each, 8% of the blob.
table WorkerAssignmentChunk {
  first_block: uint64 (key, id: 0);
  id: string (required, id: 1);
  size: uint32 (id: 2);
  dataset_base_url: string (required, id: 3);  // shared across all chunks of the dataset
  // Which copy of the chunk to download. Version 0 is the ingested one, at dataset_base_url + id;
  // any other value names the `GenerationEntry` whose prefix goes between those two parts, which
  // together form the whole download prefix.
  version: uint32 (id: 4);
  write_schema_id: uint32 (id: 5);
  // Bitmap over the tables of the `schemas` entry whose `write_schema_id` equals this one, found
  // by key lookup: ids are sparse, so the entry for id 140000 sits wherever the sort puts it. Bit
  // i (byte i/8, LSB-first) set = that roster's tables[i] present. Absent (null) = every table
  // present.
  tables_present: [ubyte] (id: 6);
  worker_indexes: [uint16] (required, id: 7);
}

root_type WorkerAssignment;
