// When changing this file, regenerate the sources by running
// flatc --rust -o gen ./assignment.fbs ./worker_assignment.fbs ./portal_assignment.fbs
// Field ids are stable wire slots and must not be renumbered.

include "assignment.fbs";

// Worker-facing assignment data.

table WorkerAssignment {
  datasets: [WorkerAssignmentDataset] (required, id: 0);
  workers: [WorkerEntry] (required, id: 1);
  schemas: [TableRoster] (required, id: 2);  // sorted by id, as (key) lookup requires
}

table TableRoster {
  write_schema_id: uint32 (key, id: 0);
  tables: [string] (required, id: 1);  // sorted; bit i of `tables_present` <-> tables[i]
}

// A batch job writes its copy of a chunk under its own prefix and publishes it by bumping the
// chunk's `version`. Readers see a consistent chunk throughout the run, and a generation stays
// private until it is published.
//
// A chunk's files therefore live at
//   base_url + id                                   (version 0, straight from ingest)
//   base_url + generations[version].base_url + id   (any other version)
//
// which for a dataset laid out as
//
//   s3://ethereum-mainnet/
//   |-- 0000000000/                                  <- ingest
//   |-- 0001000000/
//   `-- _bf/
//       |-- 01HQZK3M7X8P2NVWTC4RYFGDS9/              <- one job's output
//       |   `-- 0000000000/
//       |       `-- 0000116400-0000127899-274f02d8/
//       `-- 01HR2A9B4C6D8E0F2G4H6J8K0M/
//
// means a `_bf/01HQZK3M7X8P2NVWTC4RYFGDS9` entry, whose version the rewritten chunks carry.
table GenerationEntry {
  version: uint32 (key, id: 0);
  base_url: string (required, id: 1);  // relative to the dataset's, e.g. "_bf/01HQZK..."
}

table WorkerAssignmentDataset {
  id: string (key, id: 0);  // e.g. "s3://solana-mainnet-2"
  last_block: uint64 (id: 1);
  // Where the dataset's files live, e.g. "https://solana-mainnet-2.sqd-datasets.io". Every chunk
  // hangs off it, so it sits here and a chunk names only what distinguishes it.
  base_url: string (required, id: 2);
  // Storage prefixes of the dataset's chunk versions, sorted by version as the (key) lookup
  // requires. A version-0 chunk is the ingested one, resolved straight from the dataset's base
  // url, so this covers versions 1 and up and appears with the first rewrite.
  generations: [GenerationEntry] (id: 3);

  // --- chunk columns, all subscripted by the same chunk index ---
  //
  // Chunk id: `top/first_block-last_block-hash`.

  first_blocks: [uint64] (required, id: 4);  // ascending
  // last_block - first_block
  block_deltas: [uint32] (required, id: 5);
  hashes: [ChunkHash] (required, id: 6);
  tops: [TopRun] (required, id: 7);
  sizes: [uint32] (required, id: 8);
  write_schema_ids: [uint32] (required, id: 9);

  // CSR bitmaps over each chunk's table roster. An empty slice means all tables.
  tables_present_offsets: [uint32] (id: 10);
  tables_present: [ubyte] (id: 11);

  versions: [uint32] (id: 12);  // absent = every chunk at version 0

  // Which workers hold each chunk. CSR expresses a column of variable-length lists — chunk i's
  // workers run from worker_offsets[i] to worker_offsets[i + 1], which makes worker_offsets one
  // longer than the other columns.
  worker_offsets: [uint32] (required, id: 13);
  worker_indexes: [uint16] (required, id: 14);
}

root_type WorkerAssignment;
