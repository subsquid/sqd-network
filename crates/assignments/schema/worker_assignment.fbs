// When changing this file, regenerate the sources by running
// flatc --rust -o gen ./assignment.fbs ./worker_assignment.fbs ./portal_assignment.fbs

include "assignment.fbs";

// The worker-facing assignment: what a worker needs to download and serve its chunks, and nothing
// else. Published as NetworkState's `worker_assignment` blob; see docs/assignment-wire-format.md
// in network-scheduler for the field-by-field trace.
//
// A chunk's `write_schema_id` names its write schema -- the one covering every table and column
// physically present in the chunk. The portal's `read_schema_id` is a client-facing view that may
// hide tables; the two are separate id spaces. Column-level schema content lives in NetworkState's
// schema bundle.

table WorkerAssignment {
  datasets: [WorkerAssignmentDataset] (required);
  workers: [WorkerEntry] (required);
  schemas: [TableRoster] (required);  // sorted by id, as (key) lookup requires
}

// Ordering is fixed at publication and travels with the bitmap, so a schema that gains tables
// later cannot change what an already published blob means.
table TableRoster {
  write_schema_id: uint32 (key);
  tables: [string] (required);  // sorted; bit i of `tables_present` <-> tables[i]
}

table WorkerAssignmentDataset {
  id: string (key);  // e.g. "s3://solana-mainnet-2"
  chunks: [WorkerAssignmentChunk] (required);
  last_block: uint64;
  // Storage prefixes of the dataset's chunk versions, sorted by version as the (key) lookup
  // requires. Version 0 is a normal version and never appears here: having no entry is exactly
  // what makes a chunk the ingested one. So this is absent for a dataset nothing has rewritten.
  generations: [GenerationEntry];
}

// A batch job doesn't overwrite an ingested chunk in place: it writes its own copy under a private
// prefix and publishes it by bumping the chunk's `version`, so readers keep seeing a consistent
// chunk while the job runs and a bad generation can be abandoned by not publishing it.
//
// A chunk's files therefore live at
//   dataset_base_url + id                                   (version 0, straight from ingest)
//   dataset_base_url + generations[version].base_url + id   (any other version)
//
// which for a dataset laid out as
//
//   s3://ethereum-mainnet/
//   |-- 0000000000/                                  <- ingest
//   |-- 0001000000/
//   `-- _bf/
//       |-- 01HQZK3M7X8P2NVWTC4RYFGDS9/              <- one job's output
//       |   `-- 0000000000/
//       |       `-- 0000116400-0000127899-274f02d8/
//       `-- 01HR2A9B4C6D8E0F2G4H6J8K0M/
//
// means a `_bf/01HQZK3M7X8P2NVWTC4RYFGDS9` entry, whose version the rewritten chunks carry.
table GenerationEntry {
  version: uint32 (key);
  base_url: string (required);  // relative to dataset_base_url, e.g. "_bf/01HQZK3M7X8P2NVWTC4RYFGDS9"
}

table WorkerAssignmentChunk {
  first_block: uint64 (key);
  id: string (required);
  dataset_id: string (required);
  size: uint32;
  dataset_base_url: string (required);  // shared across all chunks of the dataset
  // Which copy of the chunk to download: 0 is the ingested one at dataset_base_url + id and has no
  // `GenerationEntry`, any other value names the one whose prefix goes between those two parts.
  // Those parts are the whole download prefix -- a chunk carries no base_url of its own.
  version: uint32;
  write_schema_id: uint32;
  // Bitmap over the tables of the `schemas` entry whose `write_schema_id` equals this one --
  // found by key lookup, NOT by indexing `schemas` positionally: ids are sparse, so the entry
  // for id 140000 is not at offset 140000. Bit i (byte i/8, LSB-first) set = that roster's
  // tables[i] present. Absent (null) = every table present.
  tables_present: [ubyte];
  worker_indexes: [uint16] (required);
}

root_type WorkerAssignment;
