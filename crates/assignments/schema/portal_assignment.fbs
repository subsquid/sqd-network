// When changing this file, regenerate the sources by running
// flatc --rust -o gen ./assignment.fbs ./worker_assignment.fbs ./portal_assignment.fbs
// Field ids are stable wire slots and must not be renumbered.

include "assignment.fbs";

// The portal-facing assignment: the routing and block metadata a portal needs to send a query to
// a worker. `ChunkHash` and `TopRun` come from assignment.fbs, shared with the worker format. Published as NetworkState's `portal_assignment` blob; see
// docs/assignment-wire-format.md in network-scheduler for the field-by-field trace.
//
// Chunks travel as columns on the dataset. A portal reads whole columns, and a column costs
// exactly its element width per chunk, which matters across millions of them.

table PortalAssignment {
  datasets: [PortalAssignmentDataset] (required, id: 0);
  workers: [PortalEntry] (required, id: 1);
}

table PortalAssignmentDataset {
  id: string (key, id: 0);
  last_block: uint64 (id: 1);
  // Full hash of the dataset head block.
  last_block_hash: string (id: 11);
  // Resolved through NetworkState's schema bundle.
  read_schema_id: uint32 (id: 2);

  // --- chunk columns, all subscripted by the same chunk index ---
  //
  first_blocks: [uint64] (required, id: 3);  // ascending
  // last_block - first_block
  block_deltas: [uint32] (required, id: 4);
  hashes: [ChunkHash] (required, id: 5);
  tops: [TopRun] (required, id: 6);

  timestamps: [uint64] (required, id: 7);  // 0 = never recorded

  versions: [uint32] (id: 8);  // absent = every chunk at version 0

  // CSR worker lists; offsets has one more entry than the chunk columns.
  worker_offsets: [uint32] (required, id: 9);
  worker_indexes: [uint16] (required, id: 10);
}

table PortalEntry {
  worker_id: WorkerId (required, id: 0);
  status: WorkerStatus (id: 1);
}

root_type PortalAssignment;
